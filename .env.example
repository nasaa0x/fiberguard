# Backend defaults. Export these in your terminal; Flask does not auto-load this file.
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: self-hosted or compatible OSRM car-routing service. No key needed for default.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
